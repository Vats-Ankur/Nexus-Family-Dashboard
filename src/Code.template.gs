/**
 * NEXUS · Family Command Deck — Google Apps Script backend
 * ---------------------------------------------------------------
 * Generated by tools/build.py from src/config.local.json — paste this as Code.gs,
 * and dist/Index.html as an HTML file named "Index". After edits:
 * Deploy → Manage deployments → edit → Version: New version → Deploy.
 * The tablet picks it up on its next refresh (or tap the logo).
 */

// ---- Dashboard settings ------------------------------------------------
const CONFIG = /*__CONFIG__*/;

// ---- Which Google Calendars to show ------------------------------------
// 'primary' = the main calendar of the Google account that owns this script.
// To add a shared family calendar or one per person, open Google Calendar →
// Settings → (calendar) → "Integrate calendar" → copy the Calendar ID.
// "name" can be a member from CONFIG.members (colors the whole calendar) or 'Family'.
const CALENDARS = /*__CALENDARS__*/;

// Public holiday calendars (gold), by Google Calendar ID. They're read with the same calendar access as
// your events (and added, hidden, to this account's calendar list if needed). Hindu festivals, Ekadashi,
// Purnima etc. are calculated by the dashboard's own Panchang engine, so India's calendar isn't needed.
const HOLIDAY_CALENDARS = [
  'en.usa#holiday@group.v.calendar.google.com',
];

// ------------------------------------------------------------------------

// ---- Family access key ------------------------------------------------
// The web app is deployed as "Anyone" (Fully Kiosk can't do a Google sign-in),
// so only links that end in ?key=<this value> can open it. Keep it private.
const ACCESS_KEY = '/*__ACCESS_KEY__*/';

function checkKey_(key) {
  if (ACCESS_KEY && String(key || '') !== ACCESS_KEY) throw new Error('locked');
}

function doGet(e) {
  const key = (e && e.parameter && e.parameter.key) || '';
  if (ACCESS_KEY && key !== ACCESS_KEY) {
    return HtmlService.createHtmlOutput(
      '<body style="background:#02050c;color:#8fb0cc;font:16px sans-serif;display:grid;place-items:center;height:95vh">' +
      '<div>NEXUS · locked. Open the link that includes the family access key.</div></body>').setTitle('Nexus');
  }
  const cfg = 'window.FD_CONFIG=' + JSON.stringify(CONFIG).replace(/</g, '\\u003c') + ';window.FD_KEY=' + JSON.stringify(key) + ';';
  const html = HtmlService.createHtmlOutputFromFile('Index').getContent()
    .replace('"__RUNTIME_CONFIG__";', () => cfg); // a string, not a comment: Apps Script strips comments from HTML files
  return HtmlService.createHtmlOutput(html)
    .setTitle('Nexus Family Deck')
    .addMetaTag('viewport', 'width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no');
}

/** Called by the dashboard every few minutes. Returns a JSON string. */
function getData(key) {
  checkKey_(key);
  const cache = CacheService.getScriptCache();
  const hit = cache.get('nexus-data-v2');
  if (hit) return hit;

  const tz = Session.getScriptTimeZone();
  const now = new Date();
  const from = new Date(now.getTime() - 2 * 864e5);
  const to = new Date(now.getTime() + 62 * 864e5);

  const calendars = CALENDARS.map(function (c) {
    try {
      const cal = c.id === 'primary' ? CalendarApp.getDefaultCalendar() : CalendarApp.getCalendarById(c.id);
      if (!cal) return { name: c.name, ok: false, error: 'calendar not found' };
      const events = cal.getEvents(from, to).map(function (e) {
        const allDay = e.isAllDayEvent();
        const o = {
          uid: e.getId() + '@' + e.getStartTime().getTime(),
          title: e.getTitle(),
          desc: String(e.getDescription() || '').replace(/<br\s*\/?>/gi, '\n').replace(/<[^>]+>/g, '').slice(0, 400),
          loc: e.getLocation() || '',
          allDay: allDay,
        };
        if (allDay) {
          o.startDate = Utilities.formatDate(e.getAllDayStartDate(), tz, 'yyyy-MM-dd');
          o.endDate = Utilities.formatDate(e.getAllDayEndDate(), tz, 'yyyy-MM-dd');
        } else {
          o.start = e.getStartTime().getTime();
          o.end = e.getEndTime().getTime();
        }
        return o;
      });
      return { name: c.name, ok: true, events: events };
    } catch (err) {
      return { name: c.name, ok: false, error: String((err && err.message) || err) };
    }
  });

  const holidays = [], holidayInfo = [];
  HOLIDAY_CALENDARS.forEach(function (id) {
    try {
      const r = holidayIcs_(id, from, to, tz);
      holidays.push(r.ics); holidayInfo.push(r.count + ' from calendar');
    } catch (err) {
      // fallback: the public iCal feed
      try {
        const url = 'https://calendar.google.com/calendar/ical/' + encodeURIComponent(id) + '/public/basic.ics';
        const res = UrlFetchApp.fetch(url, { muteHttpExceptions: true });
        const ics = res.getResponseCode() === 200 ? trimIcs_(res.getContentText(), from, to) : '';
        holidays.push(ics);
        holidayInfo.push((ics.match(/BEGIN:VEVENT/g) || []).length + ' from feed (HTTP ' + res.getResponseCode() + '; calendar: ' + String(err && err.message || err).slice(0, 60) + ')');
      } catch (e2) { holidayInfo.push('error: ' + String(e2 && e2.message || e2).slice(0, 80)); }
    }
  });

  const out = JSON.stringify({ calendars: calendars, holidays: holidays, holidayInfo: holidayInfo.join('; '), configured: CALENDARS.length > 0, fetchedAt: new Date().toISOString() });
  if (out.length < 95000) cache.put('nexus-data-v2', out, 300);
  return out;
}

/** Weather from Open-Meteo, fetched by Google so the old tablet needs no new certificates. */
function getWeather(lat, lon, unit, key) {
  checkKey_(key);
  const f =String(unit || CONFIG.units || 'C').toUpperCase() === 'F';
  const cacheKey = 'nexus-wx-' + Number(lat).toFixed(2) + ',' + Number(lon).toFixed(2) + (f ? 'F' : 'C');
  const cache = CacheService.getScriptCache();
  const hit = cache.get(cacheKey);
  if (hit) return hit;
  const url = 'https://api.open-meteo.com/v1/forecast?latitude=' + Number(lat) + '&longitude=' + Number(lon) +
    '&current=temperature_2m,apparent_temperature,relative_humidity_2m,weather_code,is_day,wind_speed_10m' +
    '&daily=weather_code,temperature_2m_max,temperature_2m_min,sunrise,sunset,precipitation_probability_max,uv_index_max' +
    '&timezone=auto&forecast_days=8' + (f ? '&temperature_unit=fahrenheit&wind_speed_unit=mph' : '');
  const r = UrlFetchApp.fetch(url, { muteHttpExceptions: true });
  if (r.getResponseCode() !== 200) throw new Error('weather HTTP ' + r.getResponseCode());
  const text = r.getContentText();
  cache.put(cacheKey, text, 1200);
  return text;
}

/** Holiday calendar → small iCal text (all-day events), read through CalendarApp. */
function holidayIcs_(id, from, to, tz) {
  let cal = CalendarApp.getCalendarById(id);
  if (!cal) cal = CalendarApp.subscribeToCalendar(id, { hidden: true, selected: false });
  if (!cal) throw new Error('holiday calendar not found');
  const esc = function (s) { return String(s || '').replace(/\\/g, '\\\\').replace(/;/g, '\\;').replace(/,/g, '\\,').replace(/\r?\n/g, '\\n'); };
  const evs = cal.getEvents(from, to);
  const lines = ['BEGIN:VCALENDAR'];
  evs.forEach(function (e) {
    const s = e.isAllDayEvent() ? e.getAllDayStartDate() : e.getStartTime();
    const en = e.isAllDayEvent() ? e.getAllDayEndDate() : e.getEndTime();
    lines.push('BEGIN:VEVENT', 'UID:' + esc(e.getId()), 'SUMMARY:' + esc(e.getTitle()), 'DESCRIPTION:' + esc(e.getDescription()),
      'DTSTART;VALUE=DATE:' + Utilities.formatDate(s, tz, 'yyyyMMdd'),
      'DTEND;VALUE=DATE:' + Utilities.formatDate(en > s ? en : new Date(s.getTime() + 864e5), tz, 'yyyyMMdd'), 'END:VEVENT');
  });
  lines.push('END:VCALENDAR');
  return { ics: lines.join('\n') + '\n', count: evs.length };
}

/** Mantra recordings: the tablet's old web view can't play Google Drive links, so the script fetches
    the MP3 (only files listed in CONFIG.mantraAudio) and returns it as base64. */
function getAudio(fileId, key) {
  checkKey_(key);
  const allowed = Object.keys(CONFIG.mantraAudio || {}).map(function (k) {
    const a = CONFIG.mantraAudio[k]; const u = typeof a === 'string' ? a : (a && a.url) || '';
    const m = u.match(/(?:\/d\/|[?&]id=)([\w-]{20,})/); return m ? m[1] : '';
  });
  if (allowed.indexOf(fileId) < 0) throw new Error('unknown recording');
  const r = UrlFetchApp.fetch('https://drive.google.com/uc?export=download&id=' + fileId, { muteHttpExceptions: true, followRedirects: true });
  if (r.getResponseCode() !== 200) throw new Error('Drive HTTP ' + r.getResponseCode());
  const ct = String(r.getHeaders()['Content-Type'] || '');
  if (/text\/html/i.test(ct)) throw new Error('Drive returned a web page: is the file shared "Anyone with the link"?');
  return Utilities.base64Encode(r.getContent());
}

/** Keep only holiday events inside the window, so the payload stays small. */
function trimIcs_(text, from, to) {
  const lo = Utilities.formatDate(from, 'UTC', 'yyyyMMdd');
  const hi = Utilities.formatDate(to, 'UTC', 'yyyyMMdd');
  const parts = text.replace(/\r\n/g, '\n').split('BEGIN:VEVENT');
  const keep = [];
  for (let i = 1; i < parts.length; i++) {
    const m = parts[i].match(/\nDTSTART[^:]*:(\d{8})/);
    if (m && m[1] >= lo && m[1] <= hi) keep.push('BEGIN:VEVENT' + parts[i].split('END:VEVENT')[0] + 'END:VEVENT\n');
  }
  return 'BEGIN:VCALENDAR\n' + keep.join('') + 'END:VCALENDAR\n';
}

/** Run once from the editor (▶ Run) to grant calendar access and check it works. */
function testSetup() {
  const d = JSON.parse(getData(ACCESS_KEY));
  d.calendars.forEach(function (c) {
    Logger.log(c.name + ': ' + (c.ok ? c.events.length + ' events' : 'ERROR ' + c.error));
  });
  Logger.log('Holidays: ' + d.holidayInfo);
  const first = Object.keys(CONFIG.mantraAudio || {}).filter(function (k) { return CONFIG.mantraAudio[k]; })[0];
  if (first) {
    const m = String(CONFIG.mantraAudio[first].url || CONFIG.mantraAudio[first]).match(/(?:\/d\/|[?&]id=)([\w-]{20,})/);
    try { Logger.log('Mantra recording "' + first + '": ' + Math.round(getAudio(m[1], ACCESS_KEY).length * 0.75 / 1024) + ' KB OK'); }
    catch (e) { Logger.log('Mantra recording "' + first + '": ERROR ' + e.message); }
  }
  const w = JSON.parse(getWeather(CONFIG.city.lat, CONFIG.city.lon, CONFIG.units, ACCESS_KEY));
  Logger.log('Weather in ' + CONFIG.city.name + ': ' + w.current.temperature_2m + '°' + (CONFIG.units || 'C'));
  Logger.log('Tablet link: ' + ScriptApp.getService().getUrl() + '?key=' + ACCESS_KEY + '   (after you deploy)');
}
